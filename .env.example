# Public website URL used for canonical and social metadata
NEXT_PUBLIC_SITE_URL=https://tcast.co.tz

# Optional secure server-side email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
QUOTE_EMAIL_TO=tahilcast@gmail.com

# Shared Supabase project (same one the Cargo App writes to). This is the
# PUBLISHABLE key only — never put the service_role key here. NEXT_PUBLIC_
# because the tracking page reads shipment data directly from Supabase in
# the browser; RLS is what actually protects the data (this key can only
# call the track_shipment() function, nothing else — every table is
# restricted to authenticated Cargo App staff).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional comma-separated trusted form origins
ALLOWED_FORM_ORIGINS=https://tcast.co.tz,https://www.tcast.co.tz
